<?xml version="1.0" encoding="UTF-8"?>
<!-- Centralized Model Registry Configuration for SLM Agents Framework (< 6GB CPU Footprint) -->
<configuration>
  <environment>
    <threads>4</threads>
    <engine>onnx</engine>
    <device>cpu</device>
  </environment>

  <models>
    <!-- Core Orchestrator Reasoning Model -->
    <model name="phi3.5-mini-instruct-onnx" category="orchestrator">
      <description>Phi-3.5 Mini Instruct INT4 AWQ ONNX model for high-reasoning agent routing</description>
      <quantization>int4</quantization>
      <repo_id>microsoft/Phi-3.5-mini-instruct-onnx</repo_id>
      <path>models/phi-3.5-mini-instruct-onnx</path>
      <used_by>
        <agent>slm_orchestrator</agent>
      </used_by>
    </model>

    <!-- Primary High-Precision Reasoning, RAG & Coding Model -->
    <model name="qwen3.5-0.8b-onnx" category="core_rag_code">
      <description>Qwen 3.5 0.8B Instruct ONNX INT4 model for RAG PDF Chat, Orchestrator reasoning, and Code synthesis</description>
      <quantization>int4</quantization>
      <repo_id>onnx-community/Qwen3.5-0.8B-ONNX</repo_id>
      <path>models/qwen3.5-0.8b-onnx</path>
      <used_by>
        <agent>slm_rag</agent>
        <agent>slm_orchestrator</agent>
        <agent>slm_code_interpreter</agent>
        <agent>slm_summarizer</agent>
        <agent>slm_meeting</agent>
        <agent>slm_pdf</agent>
        <agent>slm_document_parser</agent>
      </used_by>
    </model>


    <!-- Fine-tuned Text-to-SQL Model -->
    <model name="qwen2.5-coder-text2sql-onnx" category="text2sql">
      <description>Fine-tuned Qwen 2.5 Coder Text-to-SQL ONNX model for database schema parsing and query synthesis</description>
      <quantization>int4</quantization>
      <repo_id>spcv/qwen2.5_coder_text2sql_onnx</repo_id>
      <path>models/qwen2.5_coder_text2sql_onnx</path>
      <used_by>
        <agent>slm_text_to_sql</agent>
      </used_by>
    </model>

    <!-- Fine-tuned Math Reasoning Model -->
    <model name="qwen2.5-math-1.5b-onnx" category="math">
      <description>Fine-tuned Qwen 2.5 Math 1.5B Instruct ONNX model for symbolic computation and LaTeX math derivation</description>
      <quantization>int4</quantization>
      <repo_id>onnx-community/Qwen2.5-Math-1.5B-Instruct</repo_id>
      <path>models/qwen2.5-math-1.5b-onnx</path>
      <used_by>
        <agent>slm_math</agent>
      </used_by>
    </model>

    <!-- Vision & OCR Model -->
    <model name="qwen2-vl-2b-onnx" category="vision">
      <description>Qwen2-VL 2B Instruct ONNX model for visual chart parsing, document OCR, and image understanding</description>
      <quantization>int4</quantization>
      <repo_id>onnx-community/Qwen2-VL-2B-Instruct</repo_id>
      <path>models/qwen2-vl-2b-onnx</path>
      <used_by>
        <agent>slm_vision_parser</agent>
      </used_by>
    </model>

    <!-- Voice Speech-to-Text Model -->
    <model name="whisper-small-onnx" category="stt">
      <description>Whisper Small ONNX offline speech-to-text audio transcription engine</description>
      <quantization>int8</quantization>
      <repo_id>onnx-community/whisper-small</repo_id>
      <path>models/whisper-small-onnx</path>
      <used_by>
        <agent>slm_voice</agent>
      </used_by>
    </model>

    <!-- Dense Vector Embeddings Model -->
    <model name="all-minilm-l6-v2-onnx" category="embeddings">
      <description>all-MiniLM-L6-v2 ONNX dense vector embedding model for fast CPU semantic search</description>
      <quantization>int8</quantization>
      <repo_id>onnx-community/all-MiniLM-L6-v2-ONNX</repo_id>
      <path>models/all-minilm-l6-v2-onnx</path>
      <used_by>
        <agent>slm_embeddings</agent>
      </used_by>
    </model>

    <!-- Cross-Encoder Reranker Model -->
    <model name="bge-reranker-base-onnx" category="reranking">
      <description>BGE Reranker Base ONNX cross-encoder model for search result scoring</description>
      <quantization>int8</quantization>
      <repo_id>onnx-community/bge-reranker-base-ONNX</repo_id>
      <path>models/bge-reranker-base-onnx</path>
      <used_by>
        <agent>slm_search_orchestrator</agent>
      </used_by>
    </model>

    <!-- RAG & Meeting Summarization Model -->
    <model name="llama-3.2-3b-onnx" category="rag_summarization">
      <description>Llama 3.2 3B Instruct ONNX INT4 model for grounded retrieval and meeting synthesis</description>
      <quantization>int4</quantization>
      <repo_id>onnx-community/Llama-3.2-3B-Instruct</repo_id>
      <path>models/llama-3.2-3b-onnx</path>
      <used_by>
        <agent>slm_rag</agent>
        <agent>slm_meeting</agent>
      </used_by>
    </model>

    <!-- Abstractive Summarizer Model -->
    <model name="llama-3.2-1b-onnx" category="summarization">
      <description>Llama 3.2 1B Instruct ONNX model for abstractive executive summarization</description>
      <quantization>int4</quantization>
      <repo_id>onnx-community/Llama-3.2-1B-Instruct-ONNX</repo_id>
      <path>models/llama-3.2-1b-onnx</path>
      <used_by>
        <agent>slm_summarizer</agent>
      </used_by>
    </model>

    <!-- Specialized Technical Agent Model (CLI, Data, Security, Git, DB Migration, Web Agent) -->
    <model name="qwen2.5-coder-1.5b-onnx" category="technical_specialized">
      <description>Qwen2.5 Coder 1.5B Instruct ONNX INT4 model for CLI, Data, Security, and Git tasks</description>
      <quantization>int4</quantization>
      <repo_id>onnx-community/Qwen2.5-Coder-1.5B-Instruct</repo_id>
      <path>models/qwen2.5-coder-1.5b-onnx</path>
      <used_by>
        <agent>slm_cli_agent</agent>
        <agent>slm_data</agent>
        <agent>slm_db_migration</agent>
        <agent>slm_security</agent>
        <agent>slm_git_repo_manager</agent>
        <agent>slm_web_agent</agent>
      </used_by>
    </model>

    <!-- Multilingual Translation & Document Processing Model -->
    <model name="qwen2.5-1.5b-onnx" category="multilingual_document">
      <description>Qwen2.5 1.5B Instruct ONNX model for translation, PDF, PKB, and Email</description>
      <quantization>int4</quantization>
      <repo_id>onnx-community/Qwen2.5-1.5B-Instruct</repo_id>
      <path>models/qwen2.5-1.5b-onnx</path>
      <used_by>
        <agent>slm_translation</agent>
        <agent>slm_document_parser</agent>
        <agent>slm_email</agent>
        <agent>slm_pdf</agent>
        <agent>slm_pkb</agent>
      </used_by>
    </model>

    <!-- Fast Core SLM Engine -->
    <model name="qwen3.5-0.8b-onnx" category="llm_core">
      <description>Qwen 3.5 0.8B ONNX INT4 model for task planning, JSON cleaning, memory, and web scraping</description>
      <quantization>int4</quantization>
      <repo_id>onnx-community/Qwen3.5-0.8B-ONNX</repo_id>
      <path>models/qwen3.5-0.8b-onnx</path>
      <used_by>
        <agent>slm_task_planner</agent>
        <agent>slm_json_cleaner</agent>
        <agent>slm_memory</agent>
        <agent>slm_web_scraper</agent>
      </used_by>
    </model>
  </models>
</configuration>
