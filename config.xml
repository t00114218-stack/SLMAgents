<?xml version="1.0" encoding="UTF-8"?>
<!-- Centralized Model Registry Configuration for Open Source SLM Agents Framework -->
<configuration>
  <environment>
    <threads>4</threads>
    <engine>onnx</engine>
    <device>cpu</device>
  </environment>

  <models>
    <!-- Core Shared Reasoning & Dialogue Model -->
    <model name="qwen3.5-0.8b-onnx" category="llm_core">
      <description>Qwen 3.5 0.8B ONNX INT4 / Q4 Quantized reasoning engine (Fast CPU Inference)</description>
      <type>onnx_genai</type>
      <quantization>int4</quantization>
      <repo_id>local/qwen3.5-0.8b-onnx</repo_id>
      <path>models/qwen3.5-0.8b-onnx</path>
      <used_by>
        <agent>slm_rag</agent>
        <agent>slm_orchestrator</agent>
        <agent>slm_voice</agent>
        <agent>slm_cli_agent</agent>
        <agent>slm_code_interpreter</agent>
        <agent>slm_git_repo_manager</agent>
        <agent>slm_json_cleaner</agent>
        <agent>slm_email</agent>
        <agent>slm_meeting</agent>
        <agent>slm_task_planner</agent>
        <agent>slm_pdf</agent>
        <agent>slm_pkb</agent>
        <agent>slm_data</agent>
        <agent>slm_db_migration</agent>
        <agent>slm_math</agent>
      </used_by>
    </model>

    <!-- Fine-tuned Specialized Models -->
    <model name="qwen2.5-coder-text2sql-onnx" category="text2sql">
      <description>Fine-tuned Qwen 2.5 Coder 1.5B ONNX for Text-to-SQL schema parsing and query synthesis</description>
      <repo_id>spcv/qwen2.5_coder_text2sql_onnx</repo_id>
      <path>models/qwen2.5_coder_text2sql_onnx</path>
      <used_by>
        <agent>slm_text_to_sql</agent>
      </used_by>
    </model>

    <model name="phi3.5-mini-instruct-onnx" category="instruction_parsing">
      <description>Phi-3.5 Mini Instruct ONNX INT4 CPU optimized</description>
      <repo_id>microsoft/Phi-3.5-mini-instruct-onnx</repo_id>
      <path>models/phi-3.5-mini-instruct-onnx</path>
      <used_by>
        <agent>slm_document_parser</agent>
        <agent>slm_web_scraper</agent>
        <agent>slm_web_agent</agent>
        <agent>slm_search_orchestrator</agent>
      </used_by>
    </model>

    <model name="moondream2-onnx" category="vision">
      <description>Moondream2 1.86B lightweight vision-language model for image captioning, OCR, and Visual QA</description>
      <repo_id>Xenova/moondream2</repo_id>
      <path>models/moondream2-onnx</path>
      <used_by>
        <agent>slm_vision_parser</agent>
      </used_by>
    </model>

    <!-- Voice Agent Audio Sub-Models -->
    <model name="whisper-tiny-onnx" category="stt">
      <description>Whisper Tiny ONNX offline speech-to-text audio transcriber</description>
      <repo_id>onnx-community/whisper-tiny-ONNX</repo_id>
      <path>models/whisper-tiny-onnx</path>
      <used_by>
        <agent>slm_voice</agent>
      </used_by>
    </model>

    <model name="kokoro-82m-onnx" category="tts">
      <description>Kokoro 82M ONNX lightweight text-to-speech voice audio synthesizer</description>
      <repo_id>onnx-community/Kokoro-82M-ONNX</repo_id>
      <path>models/kokoro-82m-onnx</path>
      <used_by>
        <agent>slm_voice</agent>
      </used_by>
    </model>

    <!-- Embeddings & Translation -->
    <model name="mxbai-embed-large-onnx" category="embeddings">
      <description>MixedBread AI Embed Large ONNX dense vector embedding model</description>
      <repo_id>mixedbread-ai/mxbai-embed-large</repo_id>
      <path>models/mxbai-embed-large-onnx</path>
      <used_by>
        <agent>slm_embeddings</agent>
        <agent>slm_rag</agent>
      </used_by>
    </model>

    <model name="nllb-200-indic" category="translation">
      <description>NLLB-200 / IndicTrans2 multilingual neural translation engine</description>
      <repo_id>facebook/nllb-200-distilled-600M</repo_id>
      <path>models/nllb-200-indic</path>
      <used_by>
        <agent>slm_translation</agent>
      </used_by>
    </model>

    <model name="llama-guard-3-1b-onnx" category="security">
      <description>Llama Guard 3 1B ONNX safety and prompt injection scanner</description>
      <repo_id>onnx-community/Llama-Guard-3-1B-ONNX</repo_id>
      <path>models/llama-guard-3-1b-onnx</path>
      <used_by>
        <agent>slm_security</agent>
      </used_by>
    </model>

    <model name="mem0-tiny-onnx" category="memory">
      <description>Mem0 Tiny ONNX conversation state and entity graph memory manager</description>
      <repo_id>mem0/mem0-tiny-onnx</repo_id>
      <path>models/mem0-tiny-onnx</path>
      <used_by>
        <agent>slm_memory</agent>
      </used_by>
    </model>
  </models>
</configuration>
